# Сохраняйте файл в кодировке UTF-8 (без BOM) — иначе в терминале возможны ошибки кодировки.
# === AI API ===
OPENAI_API_KEY=your_openai_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here
BASE_URL=https://api.perplexity.ai
MODEL_NAME=sonar-pro

# === WordPress ===
WP_URL=http://your-vps-ip
WP_USERNAME=your_wp_user
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WP_AUTHOR_ID=2

# === WP: ID категорий (Записи → Категории) ===
WP_CAT_HEALTH_FITNESS=4
WP_CAT_RELAX_MASSAGE=5
WP_CAT_NUTRITION_LIFESTYLE=7
WP_CAT_CLIENT_STORIES=8
WP_CAT_AI_HEALTH=9
WP_CAT_SERVICES=10

# === ВКонтакте (для агента публикации) ===
# VK_ACCESS_TOKEN=токен_с_правами_wall_offline
# VK_GROUP_ID=123456789

# === Деплой на VPS (для scripts/deploy_to_vps.py) ===
# VPS_HOST=91.229.11.147
# VPS_USER=root
# VPS_SSH_KEY=~/.ssh/id_rsa

# === БД (опционально, для планировщика и цепочки агентов) ===
# DATABASE_URL=postgresql://user:password@localhost:5432/content_factory

# === Генерация изображений (agent9 + scripts/image_generate_api.py) ===
# SD_WEBUI_ROOT=D:\AI\stable-diffusion-webui  # Путь к папке SD WebUI (webui.bat)
# COMFYUI_URL=http://127.0.0.1:8188   # ComfyUI (типичный порт 8188), можно не задавать, если только SD
# SD_WEBUI_URL=http://127.0.0.1:7860  # SD WebUI (дефолт 7860); при занятости — 7861, 7862… agent9 пробует автоматически

# === Google Sheets (agent1 --from-queue, agent4 обратная запись) ===
# GOOGLE_APPLICATION_CREDENTIALS=config/google-sheets-credentials.json

# === Gloryon (парсер scripts/parse_gloryon_aroma.py) ===
# GLORYON_USERNAME=логин
# GLORYON_PASSWORD=пароль
# YANDEX_DRIVER_PATH=D:\content-factory\scripts\drivers\yandexdriver.exe
