    "vps_key_env":  "VPS_SSH_KEY",
    "theme_path":   "/var/www/html/wp-content/themes/flavor/inc/service-pages-defaults.php",
    "theme_child_path": "/root/sites/entuziastov75VPS/www/entuziastov75.ru/wp-content/themes/entuziastov75-child",
