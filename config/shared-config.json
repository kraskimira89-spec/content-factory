{
  "_comment": "Контракт между content-factory и entuziastov75-vps. Телефон для записи: +7 (904) 475-91-01.",
  "_version": "2.2",

  "google_sheets": {
    "spreadsheet_id": "1uL2BUXrN-E85s3OEz9DjzeT8rQouBpTQZOMjwUEmquo",
    "credentials_env": "GOOGLE_APPLICATION_CREDENTIALS",
    "sheets": {
      "Queue": { "range": "A:I", "_headers": "queue_id, topic_id, service_slug, publish_date, status, wp_page_id, wp_url, agent_run_id, notes" },
      "Services": { "range": "A:F", "_headers": "slug, wp_page_id, category, price, wp_url, name" }
    },
    "_comment": "Сервисный аккаунт: Редактор таблицы. GOOGLE_APPLICATION_CREDENTIALS — путь к JSON ключу."
  },

  "wordpress": {
    "url_env": "WP_URL",
    "username_env": "WP_USERNAME",
    "password_env": "WP_APP_PASSWORD",
    "rest_base": "/wp-json/wp/v2",
    "timeout_sec": 30
  },

  "endpoints": {
    "posts":      { "path": "/wp-json/wp/v2/posts",      "methods": ["GET", "POST"] },
    "pages":      { "path": "/wp-json/wp/v2/pages",      "methods": ["GET", "POST"] },
    "tags":       { "path": "/wp-json/wp/v2/tags",       "methods": ["GET", "POST"] },
    "categories": { "path": "/wp-json/wp/v2/categories", "methods": ["GET"] },
    "service_data": {
      "path": "/wp-json/entuziastov75/v1/service-data/{slug}",
      "methods": ["GET", "POST"],
      "_comment": "Кастомный эндпоинт: POST пишет данные услуги в wp_options, GET читает. Merge: API-данные перезаписывают дефолты из PHP"
    }
  },

  "publish_protocol": {
    "post_fields": {
      "title":      "string, заголовок из первой строки Markdown (# Заголовок)",
      "content":    "string, HTML-контент (Markdown → HTML через python-markdown с ext: extra, tables, sane_lists)",
      "status":     "enum: draft | publish | private",
      "categories": "array<int>, ID категорий WP",
      "tags":       "array<int>, ID тегов WP (создаются автоматически)"
    },
    "page_update_fields": {
      "content": "string, HTML — обновляется только post_content, заголовок/шаблон не трогается"
    },
    "statuses": {
      "success": "Публикация/обновление прошло, HTTP 200/201",
      "error":   "HTTP != 200/201 → RuntimeError с телом ответа"
    },
    "file_naming": "{timestamp}_page_{услуга}_{город}.md — Агент 3 → Агент 4"
  },

  "image_protocol": {
    "_comment": "Контракт для agent8 (придумывает промпты) и agent9 (генерирует картинки через Stable Diffusion / ComfyUI)",
    "storage_root_env": "CF_IMAGE_STORAGE_ROOT",
    "storage_root_default": "media",
    "relative_path_pattern": "images/{year}/{month}/{slug}-{index}.jpg",
    "relative_path_pattern_with_size": "images/{year}/{month}/{day}/{slug}_{network}_{variant}_{width}x{height}_{index}.jpg",
    "variants": {
      "site": [
        { "name": "hero",  "width": 1280, "height": 720 }
      ],
      "vk": [
        { "name": "feed", "width": 1200, "height": 630 }
      ],
      "insta": [
        { "name": "square", "width": 1080, "height": 1080 }
      ],
      "tg": [
        { "name": "post", "width": 1280, "height": 720 }
      ],
      "wa": [
        { "name": "post", "width": 1280, "height": 720 }
      ],
      "yt": [
        { "name": "thumb", "width": 1280, "height": 720 }
      ],
      "ok": [
        { "name": "thumb", "width": 720, "height": 405 }
      ]
    },
    "_variant_by_channel": "по 1 варианту на канал: site→hero, vk→feed, insta→square, tg→post, wa→post, yt→thumb, ok→thumb",
    "count": {
      "min": 4,
      "max": 4
    },
    "fields": {
      "prompt": "string, текст для Stable Diffusion",
      "style": "string, например 'realistic photo' или 'flat illustration'",
      "alt": "string, alt-текст для HTML/img и WP",
      "image_path": "string, относительный путь к файлу от storage_root",
      "insert_after_block": "int, fallback: после какого H2 вставить (0=лид, 1=первый H2, …)",
      "slot": "string, привязка к <!-- image_slot: X --> (problems, mechanism, result, target_audience, process, faq, utp)",
      "layout": "string, left|right|below — слева, справа или блоком под текстом",
      "width": "int, опционально",
      "height": "int, опционально"
    }
  },

  "sd_webui": {
    "base_url": "http://127.0.0.1:7860",
    "base_url_env": "SD_WEBUI_URL",
    "_comment_port": "если 7860 занят, WebUI стартует на 7861, 7862… — agent9 автоматически пробует 7860–7865 при ошибке подключения",
    "root_env": "SD_WEBUI_ROOT",
    "root_default": "D:\\AI\\stable-diffusion-webui",
    "checkpoint": "v1-5-pruned-emaonly.safetensors [6ce0161689]",
    "default_width": 1280,
    "default_height": 720,
    "sampler_name": "DPM++ 2M",
    "steps": 28,
    "cfg_scale": 7,
    "retries": 2,
    "negative_prompt": "blurry, low quality, distorted, text, watermark, logo, people, person, human, face"
  },

  "comfyui": {
    "_comment": "ComfyUI на 8188 (типичный порт). SD WebUI — sd_webui. agent9 читает из .env (COMFYUI_URL, SD_WEBUI_URL).",
    "url_env": "COMFYUI_URL",
    "url_default": "http://127.0.0.1:8188",
    "sd_webui_url_env": "SD_WEBUI_URL",
    "sd_webui_url_default": "http://127.0.0.1:7860",
    "timeout_sec": 120,
    "site_hero": {
      "width": 1280,
      "height": 720
    }
  },

  "rubrics": {
    "health_fitness":      { "title": "Здоровье и фитнес",       "wp_cat_env": "WP_CAT_HEALTH_FITNESS",       "keywords": "упражнения лфк восстановление травм операций фитнес здоровье тренажер зал" },
    "relax_massage":       { "title": "Релаксация и массаж",      "wp_cat_env": "WP_CAT_RELAX_MASSAGE",        "keywords": "лимфодренаж кедровая бочка фитобочка массаж релаксация оздоровление омоложение обертывание соляная комната" },
    "nutrition_lifestyle": { "title": "Питание и образ жизни",    "wp_cat_env": "WP_CAT_NUTRITION_LIFESTYLE",  "keywords": "питание антистресс долголетие образ жизни рекомендации" },
    "client_stories":      { "title": "Истории клиентов",         "wp_cat_env": "WP_CAT_CLIENT_STORIES",       "keywords": "история клиента кейс было стало отзыв результат специалист врач рекомендация до после" },
    "ai_health":           { "title": "ИИ и здоровье",            "wp_cat_env": "WP_CAT_AI_HEALTH",            "keywords": "искусственный интеллект ии ai нейросеть цифровизация технологии здоровье телемедицина приложения" },
    "services":            { "title": "Услуги",                   "wp_cat_env": "WP_CAT_SERVICES" }
  },

