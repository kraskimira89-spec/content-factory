  "service_data_fields": {
    "_comment": "Поля, которые content-factory генерирует для inc/service-pages-defaults.php на VPS",
    "results":          "array<string> — результаты процедуры",
    "comparison":       "{ headers: string[], rows: string[][] } — таблица сравнения",
    "faq":              "array<{ q: string, a: string }> — FAQ",
    "steps":            "array<{ text: string }> — шаги процедуры",
    "indications":      "array<string> — показания (опционально)",
    "contraindications":"array<string> — противопоказания (опционально)",
    "pricing":          "{ headers: string[], rows: string[][] } — таблица цен (опционально)"
  },

  "vk": {
    "api_version": "5.131",
    "token_env": "VK_ACCESS_TOKEN",
    "group_id_env": "VK_GROUP_ID"
  },

